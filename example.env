# Copy to `.env` (project root) and fill in. Loaded by the systemd unit
# (EnvironmentFile) and by src/config/settings.py.

# testing -> uses TEST_BOT_TOKEN + DEBUG logging; anything else uses TOKEN.
ENV=production

# Bot tokens
TOKEN=
TEST_BOT_TOKEN=

# Admin Telegram user id
ME=

# Third-party API tokens
GPT_TOKEN=
OPEN_AI_TOKEN=
AUDIO_MODEL_KEY=
YANDEX_MUSIC_TOKEN=

# Instagram credentials
INST_USERNAME=
INST_PASS=

# Email (crypto/coins mailer)
CR_MAIL=
CR_PASS=

# Database — native Postgres on the same host.
DB_NAME=yerzhan
DB_USER=yerzhan
DB_PASS=
DB_HOST=localhost
DB_PORT=5432

# Feature flags (true/false)
ENABLE_VOICE_RECOGNITION=true
ENABLE_AI_FEATURES=true
ENABLE_DOWNLOAD_FEATURES=true
